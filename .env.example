# Variables de entorno del proyecto.
#
#   cp .env.example .env
#
# El .env nunca se commitea. Cada variable nueva se agrega acá, con un comentario.
# Los comentarios van en su propia línea: junto al valor no los lee bien docker compose.

# --- Base de datos (docker compose) ---
DB_USER=postgrado_user
DB_PASSWORD=postgrado_dev_password
DB_NAME=postgrado_dev
# Puerto de la base en tu máquina. Si el 5432 está ocupado (por ejemplo, por pg-clase02),
# usá 5433 y cambialo también en las dos URLs de abajo.
DB_PORT=5432

# --- Back ---
# Entorno: development | testing | production. Los tests ponen testing solos.
ENVIRONMENT=development
# URL de la base de desarrollo y de la base de los tests (el conftest la crea sola).
DATABASE_URL=postgresql+psycopg://postgrado_user:postgrado_dev_password@localhost:5432/postgrado_dev
TEST_DATABASE_URL=postgresql+psycopg://postgrado_user:postgrado_dev_password@localhost:5432/postgrado_test
# Firma de los JWT. Mínimo 32 caracteres. Cambiar por uno propio (sin default en el código).
JWT_SECRET=cambiar-este-secreto-por-uno-propio-de-32-o-mas-caracteres
# Duración del token de acceso, en minutos (8 horas).
JWT_EXPIRA_MINUTOS=480
# Carpeta donde se guardan los PDFs (fuera de cualquier carpeta servida).
STORAGE_PATH=./.storage
# Orígenes que pueden llamar a la API desde un navegador, separados por comas.
CORS_ORIGINS=http://localhost:3000
# URL del front, para armar los links de los emails.
FRONTEND_URL=http://localhost:3000

# --- Emails (MailHog en desarrollo: interfaz web en http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=noreply@posgrado.frlp.utn.edu.ar

# --- Usuario coordinador que crea el seed ---
# Son datos de prueba de docs/SEED_DATA.json (los de la cátedra), no una clave real.
SEED_COORDINADOR_EMAIL=admin@fenix.test
SEED_COORDINADOR_PASSWORD=Admin1234!

# --- Front ---
# A dónde apunta el proxy de Vite para /api (en Docker lo pone el compose).
VITE_PROXY_TARGET=http://localhost:8000
